  "components": [
    {
      "name": "Hero Countdown",
      "kind": "card",
      "refersTo": "hero-countdown",
      "description": "Signature card: next prayer, target time, tabular countdown, Qibla bearing over faint astrolabe rings.",
      "html": "<div class=\"ds-hero\"><div class=\"ds-hero-top\"><span class=\"ds-hero-tag\"><i></i>MENUJU ASHAR</span><span class=\"ds-hero-at\">15:12 WIB</span></div><div class=\"ds-hero-count\">01:24:37</div><hr><div class=\"ds-hero-meta\"><span>Sudut Kiblat Lokasi Ini</span><b>295.1°</b></div></div>",
      "css": ".ds-hero{font-family: Roboto, system-ui, sans-serif;position:relative;overflow:hidden;background:#14382E;color:#F4F1EA;border:1px solid rgba(197,155,39,.25);border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:16px;width:320px}.ds-hero::before{content:'';position:absolute;width:290px;height:290px;right:-115px;top:-120px;border:1.5px solid rgba(197,155,39,.07);border-radius:50%}.ds-hero-top,.ds-hero-meta{display:flex;justify-content:space-between;align-items:center}.ds-hero-tag{font-size:12px;font-weight:700;letter-spacing:1.5px;opacity:.85;display:flex;gap:8px;align-items:center}.ds-hero-tag i{width:8px;height:8px;border-radius:50%;background:#C59B27}.ds-hero-at{color:#C59B27;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}.ds-hero-count{font-size:44px;font-weight:700;letter-spacing:-1px;font-variant-numeric:tabular-nums}.ds-hero hr{border:0;border-top:1px solid rgba(244,241,234,.1);margin:0}.ds-hero-meta span{font-size:12px;opacity:.7}.ds-hero-meta b{font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Prayer Row",
      "kind": "custom",
      "refersTo": "prayer-row",
      "description": "Default schedule row: name, tabular time, reminder-mode icon button.",
      "html": "<div class=\"ds-row\"><span class=\"ds-row-l\">Maghrib</span><span class=\"ds-row-r\">17:58<button class=\"ds-row-btn\" aria-label=\"Mode Pengingat Maghrib\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\"><path fill=\"currentColor\" d=\"M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2zm6-6V11c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z\"/></svg></button></span></div>",
      "css": ".ds-row{font-family: Roboto, system-ui, sans-serif;display:flex;justify-content:space-between;align-items:center;width:320px;background:#FFFFFF;color:#181816;border:1px solid #E2DDD2;border-radius:16px;padding:14px 18px}.ds-row-l{display:flex;align-items:center;gap:14px;font-size:16px;font-weight:500}.ds-row-l i{width:6px;height:6px;border-radius:50%;background:rgba(115,112,103,.5)}.ds-row-r{display:flex;align-items:center;gap:4px;font-size:17px;font-weight:600;font-variant-numeric:tabular-nums}.ds-row-btn{width:48px;height:48px;border:0;border-radius:50%;background:none;color:#C59B27;cursor:pointer;display:grid;place-items:center}.ds-row-btn:hover{background:rgba(24,24,22,.08)}.ds-row-btn:focus-visible{outline:2px solid #0F4C3A;outline-offset:2px}"
    },
    {
      "name": "Prayer Row (Next)",
      "kind": "custom",
      "refersTo": "prayer-row-next",
      "description": "The next prayer: 1.5dp cypress outline, 2dp lift, BERIKUTNYA badge.",
      "html": "<div class=\"ds-next\"><span class=\"ds-next-l\">Ashar<em>BERIKUTNYA</em></span><span class=\"ds-next-t\">15:12</span></div>",
      "css": ".ds-next{font-family: Roboto, system-ui, sans-serif;display:flex;justify-content:space-between;align-items:center;width:320px;background:#FFFFFF;border:1.5px solid #0F4C3A;border-radius:16px;padding:18px;box-shadow:0 1px 3px rgba(0,0,0,.12)}.ds-next-l{display:flex;align-items:center;gap:14px;font-size:16px;font-weight:700;color:#181816}.ds-next-l i{width:14px;height:14px;border-radius:50%;background:rgba(15,76,58,.2);display:grid;place-items:center}.ds-next-l b{width:7px;height:7px;border-radius:50%;background:#0F4C3A}.ds-next-l em{font-style:normal;font-size:9px;font-weight:700;letter-spacing:.8px;color:#0F4C3A;background:#DDE6E3;border-radius:6px;padding:3px 8px}.ds-next-t{font-size:17px;font-weight:700;color:#0F4C3A;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Reminder Mode Chips",
      "kind": "chip",
      "refersTo": "mode-chip-selected",
      "description": "Three equal segments per prayer: Adzan, Getar, Mati.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-on\">Adzan</button><button class=\"ds-chip\">Getar</button><button class=\"ds-chip\">Mati</button></div>",
      "css": ".ds-chips{font-family: Roboto, system-ui, sans-serif;display:flex;gap:8px;width:300px}.ds-chip{flex:1;font:inherit;font-size:12px;font-weight:500;padding:8px 0;border-radius:10px;border:1px solid #E2DDD2;background:#F6F4EF;color:#737067;cursor:pointer}.ds-chip:hover{border-color:#737067}.ds-chip:focus-visible{outline:2px solid #0F4C3A;outline-offset:2px}.ds-chip.ds-on{background:#DDE6E3;border:1.5px solid #0F4C3A;color:#0F4C3A;font-weight:700}"
    },
    {
      "name": "Outlined Button",
      "kind": "button",
      "refersTo": "button-outlined",
      "description": "Secondary actions: audio pickers, Tes Getar.",
      "html": "<button class=\"ds-btn-out\">Ubah Audio Reguler (.mp3 / .wav)</button>",
      "css": ".ds-btn-out{font-family: Roboto, system-ui, sans-serif;font-size:14px;font-weight:600;color:#0F4C3A;background:#FFFFFF;border:1px solid #E2DDD2;border-radius:10px;padding:10px 16px;cursor:pointer;transition:background .2s}.ds-btn-out:hover{background:#DDE6E3}.ds-btn-out:focus-visible{outline:2px solid #0F4C3A;outline-offset:2px}"
    },
    {
      "name": "Stop Button",
      "kind": "button",
